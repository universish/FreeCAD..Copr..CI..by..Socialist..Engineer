# Repackage a verified upstream FreeCAD runtime without compiling application code.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none

Name:           @PACKAGE@
Version:        @VERSION@
Release:        @RELEASE@%{?dist}
Summary:        @DISPLAY_NAME@
License:        LGPL-2.1-or-later AND Zlib AND BSD-3-Clause AND Apache-2.0 AND EUPL-1.2 AND BSL-1.0 AND MIT AND GPL-2.0-or-later AND CC-BY-SA-4.0
URL:            https://www.freecad.org/
Source0:        freecad-payload-x86_64.tar.gz
Source1:        freecad-payload-aarch64.tar.gz
ExclusiveArch:  x86_64 aarch64

Requires:       glibc libstdc++ libX11 libXext libGL hicolor-icon-theme shared-mime-info
Requires(post,postun): desktop-file-utils shared-mime-info
BuildRequires:  desktop-file-utils
BuildRequires:  appstream

%description
@DISPLAY_NAME@ packages the upstream FreeCAD runtime, keeping its application
libraries bundled under /opt while using host kernel, ELF loader, glibc ABI,
GPU drivers, and desktop integration.

%prep
%setup -q -c -n %{name}-%{version} -T
%ifarch x86_64
tar --no-same-owner --no-same-permissions -xzf %{SOURCE0} -C .
%elifarch aarch64
tar --no-same-owner --no-same-permissions -xzf %{SOURCE1} -C .
%else
echo "Unsupported architecture %{_arch}" >&2
exit 1
%endif

%build
# The upstream runtime is prebuilt; no application compilation is performed.

%install
install -d %{buildroot}/opt/%{name} %{buildroot}%{_bindir} \
    %{buildroot}%{_datadir}/applications \
    %{buildroot}%{_datadir}/icons/hicolor/scalable/apps \
    %{buildroot}%{_metainfodir}
cp -a ./. %{buildroot}/opt/%{name}/
test -x %{buildroot}/opt/%{name}/AppRun
test -s %{buildroot}/opt/%{name}/freecad-icon.svg
cat > %{buildroot}%{_bindir}/@COMMAND@ <<'EOF'
#!/bin/sh
APPDIR=/opt/%{name}
export APPDIR
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/%{name}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/%{name}"
export FREECAD_USER_HOME="$XDG_DATA_HOME"
mkdir -p "$FREECAD_USER_HOME"
exec "$APPDIR/AppRun" "$@"
EOF
chmod 0755 %{buildroot}%{_bindir}/@COMMAND@
install -m 0644 %{buildroot}/opt/%{name}/freecad-icon.svg \
    %{buildroot}%{_datadir}/icons/hicolor/scalable/apps/%{name}.svg
cat > %{buildroot}%{_datadir}/applications/@DESKTOP_ID@.desktop <<'EOF'
[Desktop Entry]
Name=@DISPLAY_NAME@
Comment=FreeCAD with the upstream bundled runtime
GenericName=CAD Application
Exec=@COMMAND@ %F
TryExec=@COMMAND@
Terminal=false
Type=Application
Icon=%{name}
Categories=Graphics;Science;Education;Engineering;
StartupNotify=true
StartupWMClass=FreeCAD
MimeType=application/x-extension-fcstd;model/step;model/stl;
EOF
desktop-file-validate %{buildroot}%{_datadir}/applications/@DESKTOP_ID@.desktop
cat > %{buildroot}%{_metainfodir}/@DESKTOP_ID@.metainfo.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@DESKTOP_ID@</id>
  <name>@DISPLAY_NAME@</name>
  <summary>FreeCAD with its upstream bundled runtime</summary>
  <description><p>FreeCAD installed with its verified upstream Linux runtime.</p></description>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LGPL-2.1-or-later AND Zlib AND BSD-3-Clause AND Apache-2.0 AND EUPL-1.2 AND BSL-1.0 AND MIT AND GPL-2.0-or-later AND CC-BY-SA-4.0</project_license>
  <launchable type="desktop-id">@DESKTOP_ID@.desktop</launchable>
  <provides><binary>@COMMAND@</binary></provides>
</component>
EOF
appstreamcli validate --no-net %{buildroot}%{_metainfodir}/@DESKTOP_ID@.metainfo.xml

%files
/opt/%{name}/
%{_bindir}/@COMMAND@
%{_datadir}/applications/@DESKTOP_ID@.desktop
%{_datadir}/icons/hicolor/scalable/apps/%{name}.svg
%{_metainfodir}/@DESKTOP_ID@.metainfo.xml

%post
for other_package in freecad freecad-candidate freecad-non-native freecad-candidate-non-native; do
  if [ "$other_package" != "%{name}" ] && rpm -q "$other_package" >/dev/null 2>&1; then
    echo "FreeCAD package $other_package is also installed; this package keeps a separate prefix, launcher, and user configuration." >&2
  fi
done
/usr/bin/update-desktop-database -q %{_datadir}/applications >/dev/null 2>&1 || :
/usr/bin/update-mime-database %{_datadir}/mime >/dev/null 2>&1 || :

%postun
/usr/bin/update-desktop-database -q %{_datadir}/applications >/dev/null 2>&1 || :
/usr/bin/update-mime-database %{_datadir}/mime >/dev/null 2>&1 || :

%changelog
* Fri Nov 20 2026 FreeCAD RPM Packager <freecad@copr.fedorainfracloud.org> - @VERSION@-@RELEASE@
- Package verified upstream runtime as an isolated non-native RPM
